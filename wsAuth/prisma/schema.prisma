generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId       String  @id @map("user_id")
  name         String
  email        String
  phone        String?
  passwordHash String? @map("password_hash")
  role         String

  @@map("users")
}
